@page
@model Week5Lab.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Class Manager";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<div class="container mt-5">
    <div class="row g-4">
        
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body bg-light rounded">
                    <h4 class="card-title mb-4 @(Model.EditId.HasValue ? "text-warning" : "text-primary")">
                        @(Model.EditId.HasValue ? "Edit Class" : "Add New Class")
                    </h4>
                    <form method="post">
                        <input type="hidden" asp-for="EditId" />
                        <div class="mb-3">
                            <label asp-for="NewClass.ClassName" class="form-label fw-semibold"></label>
                            <input asp-for="NewClass.ClassName" class="form-control" />
                            <span asp-validation-for="NewClass.ClassName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewClass.StudentCount" class="form-label fw-semibold"></label>
                            <input asp-for="NewClass.StudentCount" class="form-control" />
                            <span asp-validation-for="NewClass.StudentCount" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewClass.Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                            <span asp-validation-for="NewClass.Description" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn @(Model.EditId.HasValue ? "btn-warning" : "btn-primary") w-100">
                            @(Model.EditId.HasValue ? "Update Class" : "Add Class")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body bg-white rounded">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="card-title text-secondary">Class List</h4>
                        <form method="post" asp-page-handler="Logout" class="mb-0" onsubmit="return confirmLogout();">
                            <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1 shadow-sm px-3 py-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-right" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M6.146 11.354a.5.5 0 0 1 .708 0L10 8.207l-3.146-3.147a.5.5 0 0 1 .708-.708L11 7.793l-3.146 3.147a.5.5 0 0 1-.708 0z"/>
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5H10a.5.5 0 0 1 0 1H1.5A.5.5 0 0 1 1 8z"/>
                            </svg>
                            Logout
                            </button>
                        </form>

                    </div>

                    
                    <form method="get" class="mb-3 d-flex gap-2">
                        <input type="text" name="ClassNameFilter" value="@Model.ClassNameFilter" class="form-control" placeholder="Filter by Class Name" />
                        <button type="submit" class="btn btn-outline-primary">Filter</button>
                    </form>

                    
                    <form method="post" asp-page-handler="Export" class="mb-3" id="exportForm">
                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                        <input type="hidden" name="ClassNameFilter" value="@Model.ClassNameFilter" />

                        <input type="hidden" id="selectedColumnsInput" name="selectedColumns" />

                        <button type="submit" class="btn btn-outline-success">Export to JSON</button>
                    </form>


                    
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-light">
                        <tr>
                            <th data-column="ClassName" onclick="toggleColumnSelection('ClassName')">Class Name</th>
                            <th data-column="StudentCount" onclick="toggleColumnSelection('StudentCount')">Student Count</th>
                            <th data-column="Description" onclick="toggleColumnSelection('Description')">Description</th>
                            <th>Actions</th>
                        </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.DisplayedClasses)
                            {
                                <tr>
                                    <td data-column="ClassName">@item.ClassName</td>
                                    <td data-column="StudentCount">@item.StudentCount</td>
                                    <td data-column="Description">@item.Description</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <form method="get" asp-page="./Index">
                                                <input type="hidden" name="EditId" value="@item.Id" />
                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="ClassNameFilter" value="@Model.ClassNameFilter" />
                                                <button type="submit" class="btn btn-warning btn-sm">Edit</button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    
                    <nav class="mt-3">
                        <ul class="pagination justify-content-center">
                            @if (Model.PageNumber > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?PageNumber=@(Model.PageNumber - 1)&ClassNameFilter=@Model.ClassNameFilter">Previous</a>
                                </li>
                            }
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="?PageNumber=@i&ClassNameFilter=@Model.ClassNameFilter">@i</a>
                                </li>
                            }
                            @if (Model.PageNumber < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?PageNumber=@(Model.PageNumber + 1)&ClassNameFilter=@Model.ClassNameFilter">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    let selectedCols = new Set();

    function toggleColumnSelection(column) {
        if (selectedCols.has(column)) {
            selectedCols.delete(column);
        } else {
            selectedCols.add(column);
        }

        updateVisuals();
        updateHiddenInput();
    }

    function updateVisuals() {
        document.querySelectorAll('[data-column]').forEach(el => {
            const col = el.getAttribute('data-column');
            if (selectedCols.has(col)) {
                el.classList.add('highlight-column');
            } else {
                el.classList.remove('highlight-column');
            }
        });
    }

    function updateHiddenInput() {
        document.getElementById('selectedColumnsInput').value = Array.from(selectedCols).join(',');
    }

    // Eğer geri geldiğimizde önceki seçimler varsa
    updateVisuals();
    updateHiddenInput();
    </script>

    <style>
        .highlight-column {
            background-color: #fff3cd !important;
            transition: background-color 0.3s ease-in-out;
        }

        .column-label {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid #ced4da;
            cursor: pointer;
            user-select: none;
            transition: background-color 0.2s ease;
        }

        input[type="checkbox"]:checked + .column-label {
            background-color: #ffc107;
            color: #212529;
        }
    </style>

    <script>
        function updateHighlightedColumns() {
            const checkedColumns = Array.from(document.querySelectorAll('input[name="selectedColumns"]:checked'))
                                        .map(cb => cb.value);

            document.querySelectorAll('[data-column]').forEach(cell => {
                const column = cell.getAttribute('data-column');
                if (checkedColumns.includes(column)) {
                    cell.classList.add('highlight-column');
                } else {
                    cell.classList.remove('highlight-column');
                }
            });
        }

        document.querySelectorAll('input[name="selectedColumns"]').forEach(cb => {
            cb.addEventListener('change', updateHighlightedColumns);
        });

        updateHighlightedColumns();
        function confirmLogout() {
        return confirm("Are you sure you want to logout?");
        }
    </script>
}
<style>
    
    .column-label {
        padding: 5px 12px;
        border-radius: 25px;
        border: 1px solid #ccc;
        cursor: pointer;
        user-select: none;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .form-check input:checked + .column-label {
        background-color: #0d6efd;
        color: white;
        border-color: #0d6efd;
    }

    
    .highlight-column {
        background-color: #f8f9fa !important;
        font-weight: 600;
        transition: background-color 0.2s ease-in-out;
    }

   
    table tbody tr:hover {
        background-color: #f1f1f1;
    }

    
    .btn {
        border-radius: 20px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    
    .card {
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.07);
    }

    
    .btn-outline-success:hover,
    .btn-outline-warning:hover {
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    
    .form-check {
        display: flex;
        align-items: center;
        margin-right: 12px;
    }

    .form-check input {
        display: none;
    }
</style>

<style>
    th[data-column] {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.2s ease-in-out;
    }

    th[data-column]:hover {
        background-color: #f0f8ff;
    }

    .highlight-column {
        background-color: #fff3cd !important;
    }
</style>
