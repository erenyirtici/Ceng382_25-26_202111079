@page
@model Week5Lab.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Class Manager";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<div class="container mt-5">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body bg-light rounded">
                    <h4 class="card-title mb-4 @(Model.EditId.HasValue ? "text-warning" : "text-primary")">
                        @(Model.EditId.HasValue ? "Edit Class" : "Add New Class")
                    </h4>
                    <form method="post">
                        <input type="hidden" asp-for="EditId" />
                        <div class="mb-3">
                            <label asp-for="NewClass.ClassName" class="form-label fw-semibold"></label>
                            <input asp-for="NewClass.ClassName" class="form-control" />
                            <span asp-validation-for="NewClass.ClassName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewClass.StudentCount" class="form-label fw-semibold"></label>
                            <input asp-for="NewClass.StudentCount" class="form-control" />
                            <span asp-validation-for="NewClass.StudentCount" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewClass.Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                            <span asp-validation-for="NewClass.Description" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn @(Model.EditId.HasValue ? "btn-warning" : "btn-primary") w-100">
                            @(Model.EditId.HasValue ? "Update Class" : "Add Class")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body bg-white rounded">
                    <h4 class="card-title mb-3 text-secondary">Class List</h4>

                    <form method="get" class="mb-3 d-flex gap-2">
                        <input type="text" name="ClassNameFilter" value="@Model.ClassNameFilter" class="form-control" placeholder="Filter by Class Name" />
                        <button type="submit" class="btn btn-outline-primary">Filter</button>
                    </form>

                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Class Name</th>
                                <th>Student Count</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DisplayedClasses)
                            {
                                <tr>
                                    <td>@item.ClassName</td>
                                    <td>@item.StudentCount</td>
                                    <td>@item.Description</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <form method="get" asp-page="./Index">
                                                <input type="hidden" name="EditId" value="@item.Id" />
                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="ClassNameFilter" value="@Model.ClassNameFilter" />
                                                <button type="submit" class="btn btn-warning btn-sm">Edit</button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <nav class="mt-3">
                        <ul class="pagination justify-content-center">
                            @if (Model.PageNumber > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?PageNumber=@(Model.PageNumber - 1)&ClassNameFilter=@Model.ClassNameFilter">Previous</a>
                                </li>
                            }
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="?PageNumber=@i&ClassNameFilter=@Model.ClassNameFilter">@i</a>
                                </li>
                            }
                            @if (Model.PageNumber < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?PageNumber=@(Model.PageNumber + 1)&ClassNameFilter=@Model.ClassNameFilter">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
